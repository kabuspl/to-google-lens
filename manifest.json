{
    "manifest_version": 3,
    "name": "To Google Lens",
    "version": "2.99.0",
    "permissions": ["contextMenus", "activeTab", "storage", "scripting"],
    "host_permissions": ["<all_urls>"],

    "description": "Take a screenshot of a webpage and search on Google Lens.",

    "icons": {
        "32": "32.png",
        "128": "128.png"
    },

    "background": {
        "service_worker": "bg.js"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],

    "options_ui": {
        "page": "options.html",
        "browser_style": false
    }
}
